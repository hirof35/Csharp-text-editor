<Window x:Class="Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Editor"
        Title="Hiro Editor" Height="600" Width="900">
    <DockPanel>
        <!-- 1. ツールバー -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#333" Margin="0,0,0,2">
            <Button Content="開く" Click="Open_Click" Margin="5" Padding="10,2"/>
            <Button Content="保存" Click="Save_Click" Margin="5" Padding="10,2"/>
            <Button Content="新しいタブ" Click="NewTab_Click" Margin="5" Padding="10,2"/>
        </StackPanel>

        <!-- 2. タブコントロール -->
        <TabControl x:Name="FileTabs" Background="#1E1E1E" BorderThickness="0">

            <!-- 【見出し】タブの上のボタン部分の見た目 -->
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding FileName}" Foreground="White" VerticalAlignment="Center"/>
                        <Button Content="×" Margin="10,0,0,0" Padding="3,0" Background="Transparent" 
                                Foreground="Gray" BorderThickness="0" Cursor="Hand"
                                Click="CloseTab_Click"/>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <!-- 【中身】タブをクリックした時に表示されるメイン画面 -->
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <!-- ここにエディターを置く。Content（List<string>）をTextLinesにバインド -->
                    <local:CustomEditor TextLines="{Binding Content}" Margin="0"/>
                </DataTemplate>
            </TabControl.ContentTemplate>

        </TabControl>
    </DockPanel>
</Window>
